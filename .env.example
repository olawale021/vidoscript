# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Gemini API Key (required for the default model)
GEMINI_API_KEY=...

# Pexels API key — free at https://www.pexels.com/api/ (b-roll stock footage)
PEXELS_API_KEY=...

# Convex (set automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk auth (set by `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Also set in the Convex deployment env (npx convex env set CLERK_JWT_ISSUER_DOMAIN ...)
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Admin area (/dashboard/admin). Comma-separated emails. Also set on Convex
# (npx convex env set ADMIN_EMAILS ... and ADMIN_USER_IDS <clerk user id>).
ADMIN_EMAILS=you@example.com

# Shared secret between the Next.js server and Convex for recording AI usage.
# Generate with: openssl rand -hex 32. Set the same value on Convex.
INTERNAL_API_SECRET=

# Cloudflare R2 file storage. Files are stored under dev/ or prod/ inside the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN=
R2_BUCKET=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Apify API token (Instagram data)
APIFY_TOKEN=
