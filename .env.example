# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Gemini API Key (required for the default model)
GEMINI_API_KEY=...

# Pexels API key — free at https://www.pexels.com/api/ (b-roll stock footage)
PEXELS_API_KEY=...

# Convex (set automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk auth (set by `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Also set in the Convex deployment env (npx convex env set CLERK_JWT_ISSUER_DOMAIN ...)
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
