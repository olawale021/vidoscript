# Copy to deploy/<stack>.env on the server (prod.env or staging.env).
# Server-side API keys go in deploy/<stack>.app.env (same keys as .env.example at repo root).

# Stack name. Must match the file name (prod.env -> prod).
STACK=prod

# Hostnames (DNS A records -> server IP, Cloudflare "DNS only").
APP_HOST=app.vidoscript.app
API_HOST=api.vidoscript.app
SITE_HOST=site.vidoscript.app

# Convex dashboard port on the server's localhost
DASHBOARD_PORT=6791

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
INSTANCE_SECRET=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Admin Clerk user ids (comma-separated) for convex/admin.ts
ADMIN_USER_IDS=

# Filled after first start: docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional: pin Convex images instead of :latest
# CONVEX_VERSION=
